# Vetra Environment Configuration

# Execution & Engine Mode
VETRA_ENVIRONMENT=development
VETRA_EXECUTION_MODE=simulation
VETRA_DRY_RUN=true
VETRA_ENGINE=vllm

# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000
VLLM_METRICS_PATH=/metrics
VLLM_HEALTH_PATH=/health
VLLM_TIMEOUT_SECONDS=5.0

# Redis Metadata Store
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=vetra:
USE_IN_MEMORY_FALLBACK=true

# API Server Configuration
VETRA_API_HOST=0.0.0.0
VETRA_API_PORT=8080
VETRA_LOG_LEVEL=INFO

# Telemetry Polling Configuration
TELEMETRY_INTERVAL_SECONDS=2.0
TELEMETRY_BUFFER_SIZE=1000

# Scoring Weights (Must sum to 1.0)
SCORING_RECENCY_WEIGHT=0.4
SCORING_FREQUENCY_WEIGHT=0.3
SCORING_REUSE_WEIGHT=0.3

# Memory Thresholds (0.0 to 1.0)
GPU_MEMORY_THRESHOLD=0.85
GPU_PRESSURE_HIGH=0.90
GPU_PRESSURE_MEDIUM=0.75
CPU_MEMORY_THRESHOLD=0.80

# Economic Cost Models (USD)
COST_GPU_PER_HOUR=2.50
COST_CPU_PER_HOUR=0.40
COST_STORAGE_PER_GB_MONTH=0.05
COST_NETWORK_PER_GB=0.01

# Feature Flags for Phases 1-5
ENABLE_SECURITY=false
ENABLE_INTELLIGENCE=true
ENABLE_OPTIMIZATION=false
ENABLE_RESEARCH=false
